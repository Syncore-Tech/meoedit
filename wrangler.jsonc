{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Landing page: static files built by copying site/ (symlinks resolved) into _site/.
  // The Worker only runs for /docs/* to answer Range requests for the tutorial video.
  "name": "meoedit",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": ["/docs/*"]
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "meoedit.com", "custom_domain": true },
    { "pattern": "www.meoedit.com", "custom_domain": true }
  ]
}
